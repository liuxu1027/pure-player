<?xml version="1.0" encoding="utf-8"?>
<!--
  基于 PurePlayer res/layout/screen.xml 改造的标准 Android 播放器布局模板
  已移除 私有控件 (PlaybackController / BookmarkSeekBar / SubView 等) 与 @0x7f 资源索引，
  可直接在 Android Studio 中配合 mpv-android 的 MPVView 编译使用。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!--
      1. 视频与字幕统一渲染层
      libmpv 通过 libplacebo + libass 将视频帧与字幕直接合成到同一个 Surface 上，
      因此无需原 screen.xml 中的独立 SubView 叠层。
      若使用自定义封装类，请将 is.xyz.mpv.MPVView 替换为你的 SurfaceView 子类全路径。
    -->
    <is.xyz.mpv.MPVView
        android:id="@+id/mpv_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 1.5 字幕覆盖层（MX 风格，独立于控制层）：字幕同步 / 字幕速度悬浮条 -->
    <FrameLayout
        android:id="@+id/subtitle_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 字幕同步悬浮条 -->
        <LinearLayout
            android:id="@+id/sub_sync_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="130dp"
            android:background="#CC000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="同步"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_sync_minus"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/et_sync_value"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="center"
                android:inputType="numberSigned|numberDecimal"
                android:text="0"
                android:textColor="#CCCCCC"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="秒"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_sync_plus"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/btn_sync_close"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="#CCCCCC"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- 字幕速度悬浮条 -->
        <LinearLayout
            android:id="@+id/sub_speed_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="130dp"
            android:background="#CC000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="速度"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_sub_speed_minus"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/et_sub_speed_value"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:text="100"
                android:textColor="#CCCCCC"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_sub_speed_plus"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/btn_sub_speed_close"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="#CCCCCC"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 2. 主控制覆盖层（对应原 screen.xml 的 RelativeLayout 控制容器） -->
    <RelativeLayout
        android:id="@+id/player_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <!-- 2.1 顶部工具栏（对应 screen_toolbar） -->
        <LinearLayout
            android:id="@+id/top_toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:background="#80000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Sample_Video_1080p.mkv" />

            <TextView
                android:id="@+id/btn_decoder_mode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="HW+"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_audio_track"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="音轨"
                android:src="@drawable/ic_audiotrack"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btn_subtitle_track"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="字幕"
                android:src="@drawable/ic_subtitles"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btn_more_menu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="更多菜单"
                android:src="@drawable/ic_more_vert"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- 2.2 快捷操作栏：顶部功能菜单一排（手势对调、随机、循环、静音、定时关闭、A-B 重复、速度、截图、后台播放、屏幕旋转） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_quick_actions"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/top_toolbar"
            android:background="#80000000"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:visibility="visible" />

        <!-- 2.2b 中央大播放按钮（MX 风格）：暂停且控制层可见时显示，点一下继续播放 -->
        <ImageButton
            android:id="@+id/btn_big_play"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_big_play"
            android:contentDescription="播放"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            android:visibility="gone" />

        <!-- 2.3 中央手势调节 HUD（亮度 / 音量 / 快进退预览） -->
        <LinearLayout
            android:id="@+id/gesture_hud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="#B3000000"
            android:gravity="center"
            android:minWidth="120dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_gesture_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                tools:text="音量" />

            <TextView
                android:id="@+id/tv_gesture_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="75%" />
        </LinearLayout>

        <!-- 2.4 底部播放控制栏（对应原 PlaybackController） -->
        <LinearLayout
            android:id="@+id/bottom_controller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#99000000"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <!-- 进度条与时间行（对应 BookmarkSeekBar + 左右时间） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekbar_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000" />

                <TextView
                    android:id="@+id/tv_total_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="48dp"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 底部传输与功能按钮行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_lock"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="锁定屏幕"
                    android:src="@drawable/ic_lock"
                    app:tint="#FFFFFF" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_prev"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="上一个"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="播放或暂停"
                    android:src="@drawable/ic_pause"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btn_next"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="下一个"
                    android:src="@drawable/ic_skip_next"
                    app:tint="#FFFFFF" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btn_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="1.0x"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_aspect_ratio"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="画面比例"
                    android:src="@drawable/ic_aspect_ratio"
                    app:tint="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- 3. 缓冲加载指示器（对应 ContentLoadingProgressBar） -->
    <ProgressBar
        android:id="@+id/loading_indicator"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 4. 锁屏状态下的独立解锁按钮 -->
    <ImageButton
        android:id="@+id/btn_unlock_floating"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="16dp"
        android:background="#80000000"
        android:contentDescription="解锁屏幕"
        android:src="@drawable/ic_lock_open"
        android:visibility="gone"
        app:tint="#FFFFFF" />

</FrameLayout>
