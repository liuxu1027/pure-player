    <!-- Strings related to Settings -->
    <!-- Kept on purpose: these "*_default" strings are NOT only used by the
         deleted old mpv preference screens — live code still reads them as
         SharedPreferences fallbacks, so deleting them would break the build:
         - MPVActivity.readSettings(): pref_background_play_default,
           pref_no_ui_pause_default, pref_auto_rotation_default
         - MPVView.initOptions(): pref_video_interpolation_sync_default
         - TouchGestures.syncSettings(): pref_gesture_horiz_default,
           pref_gesture_vert_left_default, pref_gesture_vert_right_default,
           pref_gesture_tap_left_default, pref_gesture_tap_center_default,
           pref_gesture_tap_right_default
         - BackgroundPlaybackService.createNotificationChannel():
           pref_background_play_title (notification channel name) -->
