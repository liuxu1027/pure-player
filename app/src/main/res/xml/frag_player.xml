<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:key="category_player_interface"
        app:title="界面">

        <CheckBoxPreference
            app:defaultValue="false"
            app:key="double_tap_back_key"
            app:summary="需要连续按两次返回键才退出播放器"
            app:title="双击返回键退出" />

        <CheckBoxPreference
            app:defaultValue="true"
            app:key="quick_zoom"
            app:summary="允许双指捏合快速缩放画面"
            app:title="双指缩放" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="category_player_screen"
        app:title="屏幕">

        <ListPreference
            app:defaultValue="system"
            app:entries="@array/entries_player_orientation"
            app:entryValues="@array/values_player_orientation"
            app:key="player_orientation"
            app:title="方向"
            app:useSimpleSummaryProvider="true" />

        <CheckBoxPreference
            app:defaultValue="true"
            app:key="player_fullscreen"
            app:summary="播放时隐藏状态栏和导航栏"
            app:title="全屏" />

        <ListPreference
            app:defaultValue="system"
            app:entries="@array/entries_player_brightness"
            app:entryValues="@array/values_player_brightness"
            app:key="player_brightness"
            app:title="亮度"
            app:useSimpleSummaryProvider="true" />

        <CheckBoxPreference
            app:defaultValue="false"
            app:key="player_show_remaining"
            app:summary="总时长处显示剩余时间（-MM:SS）"
            app:title="显示剩余时间" />

        <CheckBoxPreference
            app:defaultValue="true"
            app:key="player_keep_screen_on"
            app:summary="播放时屏幕不自动熄灭"
            app:title="保持屏幕开启" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="category_player_control"
        app:title="控制">

        <CheckBoxPreference
            app:defaultValue="true"
            app:key="player_dtap_playpause"
            app:summary="双击屏幕中间暂停 / 继续"
            app:title="双击播放/暂停" />

        <CheckBoxPreference
            app:defaultValue="true"
            app:key="player_dtap_seek"
            app:summary="双击左三分之一后退 10 秒、右三分之一前进 10 秒"
            app:title="双击快进/快退" />

        <CheckBoxPreference
            app:defaultValue="true"
            app:key="player_sub_gestures"
            app:summary="双指上下滑动调整字幕同步"
            app:title="字幕手势" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="category_player_playback"
        app:title="播放">

        <ListPreference
            app:defaultValue="ask"
            app:entries="@array/entries_resume_last"
            app:entryValues="@array/values_resume_last"
            app:key="resume_last"
            app:title="断点续播"
            app:useSimpleSummaryProvider="true" />

        <CheckBoxPreference
            app:defaultValue="false"
            app:key="resume_only_first"
            app:summary="仅对当前会话首次打开的视频恢复进度"
            app:title="仅首次续播" />

        <SeekBarPreference
            android:max="400"
            app:defaultValue="100"
            app:key="default_playback_speed"
            app:min="25"
            app:showSeekBarValue="true"
            app:summary="单位：百分比（100 表示 1.0x）"
            app:title="默认播放倍速 (%)" />

        <CheckBoxPreference
            app:defaultValue="true"
            app:key="fast_seek"
            app:summary="定位到最近关键帧以提高拖动响应速度"
            app:title="快速定位 (Fast Seek)" />

        <CheckBoxPreference
            app:defaultValue="true"
            app:key="audio_focus"
            app:summary="其他应用播放音频时自动暂停"
            app:title="音频焦点管理" />

        <CheckBoxPreference
            app:defaultValue="true"
            app:key="media_buttons"
            app:summary="响应蓝牙或有线耳机的媒体控制按键"
            app:title="耳机线控按键" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="category_player_sticky"
        app:title="后台与画中画">

        <ListPreference
            app:defaultValue="pip"
            app:entries="@array/entries_sticky_video"
            app:entryValues="@array/values_sticky_video"
            app:key="sticky_video"
            app:title="切出应用时视频行为"
            app:useSimpleSummaryProvider="true" />

        <CheckBoxPreference
            app:defaultValue="true"
            app:key="sticky_audio"
            app:summary="仅播放音频时保留后台播放"
            app:title="后台音频播放" />
    </PreferenceCategory>

</PreferenceScreen>
